# Copy to .env and fill in. .env is git-ignored.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Auth — generate a long random string for anything real
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_TTL_MINUTES=10080

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_receipt
# Create tables on startup without Alembic (handy for local dev)
AUTO_CREATE_TABLES=true

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure Blob Storage (original receipt images)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=receipts

# Azure Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
