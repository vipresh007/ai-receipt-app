{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-prod",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd web && npm run build && npx next start -p 3100"
      ],
      "port": 3100
    }
  ]
}
