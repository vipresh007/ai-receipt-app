{
  "$schema": "./tokens.schema (informal) — canonical design tokens for AI Receipt",
  "meta": {
    "name": "AI Receipt Design Tokens",
    "version": "0.1.0",
    "note": "Single source of truth. Regenerate design/tokens.css + design/tailwind-preset.js and ios DesignSystem when this changes."
  },

  "color": {
    "light": {
      "bg":              "#FAFAF9",
      "surface":         "#FFFFFF",
      "surface-2":       "#F4F4F2",
      "surface-sunken":  "#F0EFEC",
      "border":          "#E7E5E1",
      "border-strong":   "#D6D3CD",
      "text":            "#1A1A19",
      "text-secondary":  "#6B6B66",
      "text-tertiary":   "#9A9A93",
      "text-inverse":    "#FFFFFF",

      "accent":          "#3373F1",
      "accent-hover":    "#245FD8",
      "accent-fg":       "#FFFFFF",
      "accent-muted":    "rgba(51,115,241,0.12)",
      "focus-ring":      "rgba(51,115,241,0.45)",

      "success":         "#1F9D57",
      "success-muted":   "rgba(31,157,87,0.14)",
      "warning":         "#C1841A",
      "warning-muted":   "rgba(193,132,26,0.16)",
      "danger":          "#D5473B",
      "danger-muted":    "rgba(213,71,59,0.14)",
      "info":            "#3373F1",
      "info-muted":      "rgba(51,115,241,0.12)"
    },
    "dark": {
      "bg":              "#0F0F10",
      "surface":         "#17171A",
      "surface-2":       "#202024",
      "surface-sunken":  "#0B0B0C",
      "border":          "#2B2B30",
      "border-strong":   "#3B3B42",
      "text":            "#F5F5F4",
      "text-secondary":  "#A2A2A0",
      "text-tertiary":   "#6E6E6D",
      "text-inverse":    "#17171A",

      "accent":          "#528CFF",
      "accent-hover":    "#6E9EFF",
      "accent-fg":       "#0F0F10",
      "accent-muted":    "rgba(82,140,255,0.16)",
      "focus-ring":      "rgba(82,140,255,0.55)",

      "success":         "#37C77E",
      "success-muted":   "rgba(55,199,126,0.18)",
      "warning":         "#E4A63E",
      "warning-muted":   "rgba(228,166,62,0.18)",
      "danger":          "#F26A5C",
      "danger-muted":    "rgba(242,106,92,0.18)",
      "info":            "#528CFF",
      "info-muted":      "rgba(82,140,255,0.16)"
    }
  },

  "category": {
    "_order": ["groceries","restaurants","transport","shopping","entertainment","health","utilities","travel","other"],
    "groceries":     { "light": "#2FA36B", "dark": "#46C088" },
    "restaurants":   { "light": "#E1873C", "dark": "#F2A25C" },
    "transport":     { "light": "#3B82C4", "dark": "#5AA0E0" },
    "shopping":      { "light": "#D2649B", "dark": "#EC85B8" },
    "entertainment": { "light": "#8B5CD6", "dark": "#A98AE6" },
    "health":        { "light": "#D5544A", "dark": "#F0776C" },
    "utilities":     { "light": "#C0982A", "dark": "#E3C04A" },
    "travel":        { "light": "#2FA6A0", "dark": "#48C4BE" },
    "other":         { "light": "#8A8A83", "dark": "#9A9A94" }
  },

  "space": {
    "hair": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20,
    "2xl": 24, "3xl": 32, "4xl": 40, "5xl": 48, "6xl": 64
  },

  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 28, "pill": 999 },

  "typography": {
    "fontFamily": {
      "ios": "SF Pro (system)",
      "web": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    "numeric": "tabular figures for all money / metrics (SwiftUI .monospacedDigit(); CSS font-variant-numeric: tabular-nums)",
    "scale": {
      "display":  { "size": 34, "line": 40, "weight": 700, "tracking": "-0.02em" },
      "title":    { "size": 28, "line": 34, "weight": 700, "tracking": "-0.01em" },
      "headline": { "size": 20, "line": 26, "weight": 600, "tracking": "-0.005em" },
      "body":     { "size": 16, "line": 24, "weight": 400, "tracking": "0" },
      "callout":  { "size": 15, "line": 22, "weight": 400, "tracking": "0" },
      "subhead":  { "size": 13, "line": 18, "weight": 500, "tracking": "0", "role": "secondary label" },
      "caption":  { "size": 12, "line": 16, "weight": 400, "tracking": "0" },
      "micro":    { "size": 11, "line": 14, "weight": 600, "tracking": "0.04em", "transform": "uppercase" }
    }
  },

  "elevation": {
    "_note": "Prefer borders + surface steps. Dark mode leans on surface lightness, not shadow.",
    "e0": { "light": "none", "dark": "none" },
    "e1": { "light": "0 1px 2px rgba(20,18,15,0.06), 0 1px 1px rgba(20,18,15,0.04)", "dark": "0 1px 2px rgba(0,0,0,0.5)" },
    "e2": { "light": "0 6px 20px rgba(20,18,15,0.10), 0 2px 6px rgba(20,18,15,0.06)", "dark": "0 8px 24px rgba(0,0,0,0.55)" }
  },

  "motion": {
    "duration": { "instant": 0, "fast": 120, "base": 200, "slow": 320, "deliberate": 480 },
    "easing": {
      "standard":   "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "spring_ios": { "response": 0.35, "dampingFraction": 0.82 },
    "reducedMotion": "replace slides/scales with an opacity fade of duration <= base"
  },

  "icon": {
    "ios": "SF Symbols",
    "web": "lucide-react",
    "sizes": { "sm": 16, "md": 20, "lg": 24 },
    "strokeWeb": 1.75
  },

  "layout": {
    "screenPaddingX": 16,
    "contentMaxWidth": 1120,
    "cardPadding": 16,
    "listRowMinHeight": 56,
    "tapTargetMin": 44
  }
}
