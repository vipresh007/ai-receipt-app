{
  "$schema": "./tokens.schema (informal) — canonical design tokens for AI Receipt",
  "meta": {
    "name": "AI Receipt Design Tokens",
    "version": "0.3.0",
    "note": "Single source of truth. Regenerate design/tokens.css + design/tailwind-preset.js and ios DesignSystem when this changes. v0.3.0 = ledger palette across the app: warm paper (light) / ink (dark) grounds, gold as the action color (deep gold #8A5E0F in light for contrast), and an always-ink hero panel with a gold glow — matching the landing page. iOS DesignSystem not yet updated to 0.3.0."
  },

  "color": {
    "light": {
      "bg":              "#F3EEE3",
      "surface":         "#FBF8F2",
      "surface-2":       "#EDE7DA",
      "surface-sunken":  "#E8E1D2",
      "border":          "#E2DACA",
      "border-strong":   "#CFC5B1",
      "text":            "#1E2321",
      "text-secondary":  "#5B5F59",
      "text-tertiary":   "#8B8D85",
      "text-inverse":    "#FBF8F2",

      "accent":          "#8A5E0F",
      "accent-hover":    "#74500C",
      "accent-fg":       "#FFFFFF",
      "accent-muted":    "rgba(138,94,15,0.12)",
      "focus-ring":      "rgba(138,94,15,0.4)",

      "gold":            "#D9AE5C",

      "success":         "#1F8A57",
      "success-muted":   "rgba(31,138,87,0.13)",
      "warning":         "#B7791A",
      "warning-muted":   "rgba(183,121,26,0.15)",
      "danger":          "#C8453A",
      "danger-muted":    "rgba(200,69,58,0.13)",
      "info":            "#0E6E58",
      "info-muted":      "rgba(14,110,88,0.12)",

      "hero-gradient":   "radial-gradient(120% 140% at 100% 0%, rgba(217,174,92,0.18) 0%, transparent 55%), linear-gradient(160deg, #0C1412 0%, #14231F 100%)",
      "hero-text":       "#F1ECE1",
      "hero-chip-bg":    "rgba(255,255,255,0.08)",
      "hero-cta-text":   "#0C1412",
      "hero-cta-hover":  "#E6DFC9"
    },
    "dark": {
      "bg":              "#0C1412",
      "surface":         "#121D1A",
      "surface-2":       "#182723",
      "surface-sunken":  "#08100E",
      "border":          "#21302B",
      "border-strong":   "#2F413B",
      "text":            "#F1ECE1",
      "text-secondary":  "#A7ADA5",
      "text-tertiary":   "#6E766F",
      "text-inverse":    "#121D1A",

      "accent":          "#D9AE5C",
      "accent-hover":    "#E8C67F",
      "accent-fg":       "#0C1412",
      "accent-muted":    "rgba(217,174,92,0.14)",
      "focus-ring":      "rgba(217,174,92,0.5)",

      "gold":            "#D9AE5C",

      "success":         "#37C77E",
      "success-muted":   "rgba(55,199,126,0.16)",
      "warning":         "#E4A63E",
      "warning-muted":   "rgba(228,166,62,0.16)",
      "danger":          "#F26A5C",
      "danger-muted":    "rgba(242,106,92,0.16)",
      "info":            "#35C79A",
      "info-muted":      "rgba(53,199,154,0.16)",

      "hero-gradient":   "radial-gradient(120% 140% at 100% 0%, rgba(217,174,92,0.16) 0%, transparent 55%), linear-gradient(160deg, #0A110F 0%, #172824 100%)",
      "hero-text":       "#F1ECE1",
      "hero-chip-bg":    "rgba(255,255,255,0.08)",
      "hero-cta-text":   "#0C1412",
      "hero-cta-hover":  "#E6DFC9"
    }
  },

  "category": {
    "_order": ["groceries","restaurants","transport","shopping","entertainment","health","utilities","travel","other"],
    "groceries":     { "light": "#2FA36B", "dark": "#46C088" },
    "restaurants":   { "light": "#E1873C", "dark": "#F2A25C" },
    "transport":     { "light": "#3B82C4", "dark": "#5AA0E0" },
    "shopping":      { "light": "#D2649B", "dark": "#EC85B8" },
    "entertainment": { "light": "#8B5CD6", "dark": "#A98AE6" },
    "health":        { "light": "#D5544A", "dark": "#F0776C" },
    "utilities":     { "light": "#C0982A", "dark": "#E3C04A" },
    "travel":        { "light": "#2FA6A0", "dark": "#48C4BE" },
    "other":         { "light": "#8A8A83", "dark": "#9A9A94" }
  },

  "space": {
    "hair": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20,
    "2xl": 24, "3xl": 32, "4xl": 40, "5xl": 48, "6xl": 64
  },

  "radius": { "sm": 8, "md": 12, "lg": 20, "xl": 24, "2xl": 28, "pill": 999 },

  "typography": {
    "fontFamily": {
      "ios": "SF Pro (system)",
      "web": "'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    },
    "numeric": "tabular figures for all money / metrics (SwiftUI .monospacedDigit(); CSS font-variant-numeric: tabular-nums)",
    "scale": {
      "display":  { "size": 34, "line": 40, "weight": 700, "tracking": "-0.02em" },
      "title":    { "size": 28, "line": 34, "weight": 700, "tracking": "-0.01em" },
      "headline": { "size": 20, "line": 26, "weight": 600, "tracking": "-0.005em" },
      "body":     { "size": 16, "line": 24, "weight": 400, "tracking": "0" },
      "callout":  { "size": 15, "line": 22, "weight": 400, "tracking": "0" },
      "subhead":  { "size": 13, "line": 18, "weight": 500, "tracking": "0", "role": "secondary label" },
      "caption":  { "size": 12, "line": 16, "weight": 400, "tracking": "0" },
      "micro":    { "size": 11, "line": 14, "weight": 600, "tracking": "0.04em", "transform": "uppercase" }
    }
  },

  "elevation": {
    "_note": "Soft, diffused shadow is the default card treatment (Ledger direction) — no border. Dark mode uses a deeper, softer black shadow rather than surface lightness alone.",
    "e0": { "light": "none", "dark": "none" },
    "e1": { "light": "0 10px 28px rgba(20,24,20,0.08), 0 2px 8px rgba(20,24,20,0.05)", "dark": "0 10px 30px rgba(0,0,0,0.5), 0 2px 10px rgba(0,0,0,0.35)" },
    "e2": { "light": "0 14px 34px rgba(20,24,20,0.12), 0 4px 12px rgba(20,24,20,0.07)", "dark": "0 16px 40px rgba(0,0,0,0.6), 0 4px 14px rgba(0,0,0,0.4)" }
  },

  "motion": {
    "duration": { "instant": 0, "fast": 120, "base": 200, "slow": 320, "deliberate": 480 },
    "easing": {
      "standard":   "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "spring_ios": { "response": 0.35, "dampingFraction": 0.82 },
    "reducedMotion": "replace slides/scales with an opacity fade of duration <= base"
  },

  "icon": {
    "ios": "SF Symbols",
    "web": "lucide-react",
    "sizes": { "sm": 16, "md": 20, "lg": 24 },
    "strokeWeb": 1.75
  },

  "layout": {
    "screenPaddingX": 16,
    "contentMaxWidth": 1120,
    "cardPadding": 16,
    "listRowMinHeight": 56,
    "tapTargetMin": 44
  }
}
