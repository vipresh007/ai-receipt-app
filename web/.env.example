# Copy to .env.local (git-ignored).

# --- Auth0 ---
# From your Auth0 "Regular Web Application":
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Session cookie encryption key — generate with: openssl rand -hex 32
AUTH0_SECRET=
# The identifier of the Auth0 API that represents the backend:
AUTH0_AUDIENCE=https://api.ai-receipt

# --- Backend ---
# FastAPI base URL (server-side only — never exposed to the browser).
BACKEND_URL=http://localhost:8000
