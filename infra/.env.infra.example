# Copy to infra/.env.infra (git-ignored) to override provisioning defaults.

# NAME_PREFIX=airreceipt          # prefixes every resource name
# LOCATION=eastus                 # Azure region (must have Azure OpenAI + gpt-4o)
# RESOURCE_GROUP=airreceipt-rg

# OPENAI_DEPLOYMENT=gpt-4o        # or gpt-4o-mini for lower cost
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_VERSION=2024-08-06
# OPENAI_CAPACITY=20             # thousands of tokens/min for the deployment

# PG_ADMIN_USER=airadmin
# PG_ADMIN_PASSWORD=             # leave blank to auto-generate
# PG_SKU=Standard_B1ms          # Burstable, cheapest; bump for production
# PG_STORAGE_GB=32

# STORAGE_NAME=                  # 3-24 lowercase alnum; blank -> derived + random
