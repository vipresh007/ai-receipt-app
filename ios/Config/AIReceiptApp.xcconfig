// Base build configuration for the AIReceiptApp target.
//
// Real values live in Config/Secrets.xcconfig (git-ignored) — copy
// Config/Secrets.example.xcconfig to create it.

// Host (and optional path) of the receipt-extraction backend, WITHOUT a scheme
// — xcconfig treats "//" as a comment, so "https://" cannot appear here.
// Example: my-worker.workers.dev  or  api.myapp.com/receipts
// Left empty here; the app falls back to MockReceiptExtractor when unset.
EXTRACTION_API_HOST =

// Auth0 (Google sign-in). These identify a PUBLIC native client — not secrets —
// so they're committed here (mirrors Auth0's own Auth0.plist convention) and a
// fresh clone / CI builds with working sign-in. The API audience must match the
// backend's AUTH0_AUDIENCE. Full setup: docs/AUTH.md.
// Override in Secrets.xcconfig if you point at a different tenant.
AUTH0_DOMAIN = dev-nvjgstqap8b8wb68.us.auth0.com
AUTH0_CLIENT_ID = fO5rWCD0FHGA13ty7Y9pKXXWnrw86ES0
AUTH0_AUDIENCE = https:/$()/api.ai-receipt

// Pull in local secrets if the file exists ("?" = optional include).
#include? "Secrets.xcconfig"
