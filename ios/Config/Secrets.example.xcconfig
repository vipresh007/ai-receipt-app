// Copy this file to Config/Secrets.xcconfig (git-ignored) and fill in:
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// Host + optional path of your extraction backend, NO scheme (no "https://").
// The app always talks to it over HTTPS (localhost / 127.0.0.1 / *.local: HTTP).
// With it empty the app runs fully on MockReceiptExtractor + local-only data.

EXTRACTION_API_HOST = ai-receipt-dev-api.ashymoss-2c5773fb.eastus2.azurecontainerapps.io

// Optional: only if you use your own Auth0 tenant. Defaults for the shared dev
// tenant are set in AIReceiptApp.xcconfig, so normally leave these commented.
// AUTH0_DOMAIN = your-tenant.us.auth0.com
// AUTH0_CLIENT_ID = your-native-app-client-id
// AUTH0_AUDIENCE = https:/$()/api.ai-receipt
